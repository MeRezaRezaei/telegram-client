{
    "name": "merezarezaei/telegram-client",
    "description": "Telegram client for Laravel — Postgres update truth, Redis hot-reload bus, daemon, backfill, backups",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "telegram",
        "laravel",
        "mtproto",
        "eloquent",
        "postgres",
        "redis",
        "updates",
        "daemon",
        "backfill",
        "backup",
        "dto",
        "multi-account"
    ],
    "homepage": "https://github.com/MeRezaRezaei/telegram-client",
    "support": {
        "issues": "https://github.com/MeRezaRezaei/telegram-client/issues",
        "source": "https://github.com/MeRezaRezaei/telegram-client/tree/main",
        "docs": "https://github.com/MeRezaRezaei/telegram-client#readme",
        "security": "https://github.com/MeRezaRezaei/telegram-client/security/advisories"
    },
    "authors": [
        {
            "name": "MeRezaRezaei"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "merezarezaei/teleproto": "^1.1 || ^1.2",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "spatie/laravel-data": "^4.0",
        "laravel/prompts": "^0.3",
        "symfony/uid": "^6.0|^7.0",
        "illuminate/redis": "^10.0|^11.0|^12.0",
        "predis/predis": "^3.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "spaze/phpstan-disallowed-calls": "^4.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^10.11"
    },
    "autoload": {
        "psr-4": {
            "MeRezaRezaei\\TelegramClient\\": "src",
            "MeRezaRezaei\\TelegramClient\\Schema\\Generated\\": "generated"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MeRezaRezaei\\TelegramClient\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MeRezaRezaei\\TelegramClient\\TelegramClientServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --no-progress"
    },
    "config": {
        "allow-plugins": false
    }
}

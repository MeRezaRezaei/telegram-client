{
    "name": "merezarezaei/telegram-client",
    "description": "Stand-alone Telegram client for Laravel — update ingestion into Postgres truth, Redis hot-reload bus, backfill, encrypted channel backups, DTOs & Eloquent from the official schema",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "merezarezaei/teleproto": "dev-main",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "spatie/laravel-data": "^4.0",
        "laravel/prompts": "^0.3",
        "symfony/uid": "^6.0|^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "spaze/phpstan-disallowed-calls": "^4.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": { "MeRezaRezaei\\TelegramClient\\": "src" }
    },
    "autoload-dev": {
        "psr-4": { "MeRezaRezaei\\TelegramClient\\Tests\\": "tests" }
    },
    "extra": {
        "laravel": {
            "providers": ["MeRezaRezaei\\TelegramClient\\TelegramClientServiceProvider"]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --no-progress"
    },
    "repositories": [
        { "type": "path", "url": "../teleproto", "options": { "symlink": true } }
    ],
    "config": { "allow-plugins": false }
}
